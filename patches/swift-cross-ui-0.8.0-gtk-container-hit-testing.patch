+    /// Re-derive whether a layout container can be hit-tested at all.
+    ///
+    /// CUESYNC-9 round 18 (specs/CUESYNC-9-findings.md §0.17). `gtk_widget_pick()`
+    /// returns the deepest widget that CONTAINS the point and is targetable — and a
+    /// container with no targetable descendants still satisfies that, so picking
+    /// stops there and the click is swallowed before it reaches whatever sits
+    /// underneath. CUESYNC-8 excluded `Shape` leaves from picking
+    /// (`createPathWidget` sets `canTarget = false` on the `DrawingArea`), but every
+    /// view is wrapped in one of these `Fixed` containers and those stayed
+    /// targetable, so a decorative overlay/background still absorbed every click on
+    /// the control beneath it. Measured on Windows: 187 of 187 grid samples over the
+    /// whole client area picked a container, never once a `GtkButton`, and the leaf
+    /// was invariably a `Fixed` whose only child was a `tgt=false` `DrawingArea`.
+    ///
+    /// A container keeps `canTarget` when it owns event controllers (it is itself a
+    /// tap/hover target — `createTapGestureTarget`/`createHoverTarget` attach to the
+    /// widget directly), so this only ever excludes purely decorative subtrees.
+    private func refreshTargetability(of container: Fixed) {
+        container.canTarget =
+            !container.eventControllers.isEmpty
+            || container.children.contains { $0.canTarget }
+    }
+
     public func removeAllChildren(of container: Widget) {
         let container = container as! Fixed
         container.removeAllChildren()
+        refreshTargetability(of: container)
     }
 
     public func insert(_ child: Widget, into container: Widget, at index: Int) {
         let container = container as! Fixed
         container.put(child, index: index, x: 0, y: 0)
+        refreshTargetability(of: container)
     }
 
