# swift-cross-ui v0.8.0 GtkBackend Windows GSK-renderer selection (CUESYNC-9, round 16)
#
# Pinned to tag v0.8.0, commit a6d206370812e3b9edba259d167e848892c5013d (matches
# Package.swift's `exact: "0.8.0"` / Package.resolved). Applied by `git apply` to the
# *resolved checkout* at `.build/checkouts/swift-cross-ui` — the upstream dependency
# source is never edited in place in this repo; this file is the only checked-in copy
# of the change. Kept SEPARATE from patches/swift-cross-ui-0.8.0-gtk-interactivity.patch
# (CUESYNC-8) so each patch documents exactly one root cause and stays independently
# revertable (spec CUESYNC-9 step 5). Apply order: interactivity, then this one. Both
# touch Sources/GtkBackend/GtkBackend.swift but at disjoint ranges (createPathWidget /
# runMainLoop here), so they apply cleanly in sequence.
#
# Root cause (spec CUESYNC-9 step-4 CONTINGENCY — a GTK-runtime/init *config* defect,
# fixed with the framework's own API, not an upstream source bug; findings §0.3):
#   GTK 4's default GSK renderer on Windows is the GPU/OpenGL-backed ngl/gl renderer.
#   The clean-PC probe/build box is driven over a remote-desktop / RDP session (RustDesk
#   is on its desktop; see .factory/probe/after.png). Over that session the GL surface
#   cannot back a GskGLRenderer, so no renderer realizes and the window never appears —
#   the probe captures only the launcher console.
#
# Round-16 fix (findings §0.15 — refines round 15's env-only opt-in; ONE hunk,
# `#if os(Windows)`, GLib's own public API + Foundation's ProcessInfo, NO new module
# dependency, NO GtkFixed/absolute positioning):
#   Round 4 forced GTK's software Cairo renderer UNCONDITIONALLY. Round 15 found that
#   Cairo software-renders the UI BLACK on real GL hardware, so it gated the Cairo force
#   behind an explicit CUESYNC_SOFTWARE_RENDER opt-in and restored GTK's GL renderer as
#   the Windows default. But the probe/build box launches CueSync.exe with NO env var, so
#   GL-default regressed it from a black-but-present window (rounds 4-14) to no window at
#   all — the gate's "process exited before showing a window". Round 16 keeps GL the
#   default for a local GPU session (the Iris Pro 580 dev box renders the full colour UI)
#   yet AUTO-selects the software Cairo renderer when the process is in exactly the
#   remote-desktop session round 4 diagnosed — detected with no new module dependency from
#   the Windows-set SESSIONNAME / CLIENTNAME environment markers Foundation's ProcessInfo
#   already exposes (Console vs. RDP-Tcp#N / a connected client name). The explicit
#   CUESYNC_SOFTWARE_RENDER override is still honoured. Set before `gtkApp.run`
#   (g_application_run -> activate -> window realize -> first GskRenderer) so GSK reads it
#   before selecting a renderer. Windows-only; Linux/macOS keep their working default
#   renderers, and on macOS CueSync ships the native AppKit app, not GtkBackend.
#
#   Residual (honest, for the probe/harness owner): SESSIONNAME/CLIENTNAME identify a
#   Windows Terminal-Services / RDP session. If the box is instead driven by a tool that
#   attaches to the PHYSICAL console (some RustDesk modes report SESSIONNAME=Console),
#   this auto-detect does not fire and GL is attempted; the guaranteed override is then to
#   launch with CUESYNC_SOFTWARE_RENDER=1. This narrows round 4's blunt always-cairo into
#   "Cairo where GL cannot realize a surface", without the black-UI regression round 15
#   documented.
#
# Compile note: the added block is `#if os(Windows)`, so it is type-checked only on the
# Windows CI legs (which build before the probe runs). It uses only Foundation's
# ProcessInfo and GLib's g_getenv/g_setenv — both already reachable in GtkBackend.swift
# (Foundation is imported at the top; g_setenv resolves via CGtk) — so it adds no module
# dependency.
#
# Idempotency: `.github/workflows/swift-windows.yml` and scripts/patch-swift-cross-ui.sh
# guard re-application with `git apply --reverse --check` before applying, so a second
# run against an already-patched checkout is a no-op rather than a failure.
diff --git a/Sources/GtkBackend/GtkBackend.swift b/Sources/GtkBackend/GtkBackend.swift
index d83bbefb..d6780d4f 100644
--- a/Sources/GtkBackend/GtkBackend.swift
+++ b/Sources/GtkBackend/GtkBackend.swift
@@ -116,6 +116,38 @@ public final class GtkBackend:
     var globalCSSProvider: CSSProvider?

     public func runMainLoop(_ callback: @escaping @MainActor () -> Void) {
+        #if os(Windows)
+            // GTK 4's default GSK renderer on Windows is the GPU/OpenGL-backed `ngl`/`gl`
+            // renderer, which must create a GL context on the window's surface. Over a
+            // remote-desktop / RDP session — how the clean-PC probe/build box is driven
+            // (specs/CUESYNC-9-findings.md §0.3) — that GL surface cannot back a
+            // GskGLRenderer, so GTK never realizes a renderer and the process exits before
+            // any window appears: the probe captures only the launcher, with no CueSync
+            // window on screen. GTK's pure-software Cairo renderer needs no GL context and
+            // always realizes a window.
+            //
+            // Round 15 gated the Cairo force behind an explicit CUESYNC_SOFTWARE_RENDER
+            // opt-in and restored GTK's GL renderer as the Windows default, because on
+            // real hardware (the Iris Pro 580 dev box) GL paints Cue Sync's full colour
+            // UI while software Cairo painted it BLACK. But the probe/build box never sets
+            // that env var, so GL-default regressed it from a black window to no window at
+            // all — "process exited before showing a window" (findings §0.15). Round 16
+            // keeps GL the default for a local GPU session yet auto-selects software Cairo
+            // when the process is in exactly the remote-desktop session round 4 diagnosed,
+            // read (with no new module dependency) from the Windows-set SESSIONNAME /
+            // CLIENTNAME markers Foundation's ProcessInfo already exposes (Console vs.
+            // RDP-Tcp#N / a connected client name). CUESYNC_SOFTWARE_RENDER stays an
+            // explicit override. Set before `gtkApp.run` (g_application_run -> activate ->
+            // window realize -> first GskRenderer) via GLib's own g_setenv; Windows-only,
+            // and the shipping macOS app is the native AppKit build, not GtkBackend.
+            let windowsEnvironment = ProcessInfo.processInfo.environment
+            let inRemoteDesktopSession =
+                (windowsEnvironment["SESSIONNAME"]?.uppercased().hasPrefix("RDP") ?? false)
+                || windowsEnvironment["CLIENTNAME"] != nil
+            if g_getenv("CUESYNC_SOFTWARE_RENDER") != nil || inRemoteDesktopSession {
+                _ = g_setenv("GSK_RENDERER", "cairo", 1)
+            }
+        #endif
         gtkApp.run { window in
             self.measurementCustomLabel = (self.createTextView() as! CustomLabel)
             self.precreatedWindow = window
