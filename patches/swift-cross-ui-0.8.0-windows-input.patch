+                    // into a busy-loop that wakes the GLib main context every iteration
+                    // and starves GDK's win32 event + frame-clock sources of the thread
+                    // — the empty, size-collapsed window with dead input the click-probe
+                    // captured. Floor at one ~120 Hz frame so Foundation stays serviced
+                    // (upstream PR #141) without monopolizing the loop GDK needs to both
+                    // paint and dispatch input.
+                    return max(min(Int($0.timeIntervalSinceNow * 1000), 50), 8)
+                #else
+                    return max(min(Int($0.timeIntervalSinceNow * 1000), 50), 0)
+                #endif
             }
             mainRunLoopTicklingLoop(nextDelayMilliseconds: nextDelay)
         }
