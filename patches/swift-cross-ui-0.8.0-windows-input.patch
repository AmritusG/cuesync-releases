+    // Calling it directly services @MainActor / DispatchQueue.main work with NO
+    // CFRunLoop pass at all — and therefore no Foundation
+    // PeekMessage/DispatchMessage drain competing with GDK for this thread's
+    // one Win32 message queue. Exported by swift-corelibs-libdispatch on every
+    // non-Darwin platform (CoreFoundation links it the same way).
+    @_silgen_name("_dispatch_main_queue_callback_4CF")
+    private func scui_dispatchMainQueueCallback4CF(_ msg: UnsafeMutableRawPointer?)
+#endif
+
 extension App {
     public typealias Backend = GtkBackend
 
