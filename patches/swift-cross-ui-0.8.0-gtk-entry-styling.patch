+            //
+            // NB: keep this stylesheet free of `/* */` comments. GTK's CSS parser
+            // rejected a comment containing braces with "Unterminated block at end of
+            // document" and silently dropped every rule after it.
             let provider = CSSProvider()
             provider.loadCss(
                 from: """
@@ -173,6 +194,26 @@ public final class GtkBackend:
                     .navigation-sidebar > row { margin: 0;
                         padding: 0;
                     }
