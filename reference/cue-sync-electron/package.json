{
  "name": "cue-sync",
  "version": "1.0.0",
  "description": "Cue Sync - Rekordbox, Serato, Engine DJ, ShowKontrol to Resolume Envelope Converter",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:app && electron .",
    "dev": "npm run build:app && electron . --dev",
    "build:app": "node build.js",
    "build:app:minify": "node build.js --minify",
    "build": "npm run build:app:minify && electron-builder",
    "build:mac": "npm run build:app:minify && electron-builder --mac",
    "build:win": "npm run build:app:minify && electron-builder --win",
    "build:linux": "npm run build:app:minify && electron-builder --linux"
  },
  "author": "Cue Sync",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.cuesync.app",
    "productName": "Cue Sync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/app.js",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb"]
    }
  }
}
